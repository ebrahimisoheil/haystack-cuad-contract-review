# Never commit real credentials.
# This file is loaded automatically after you copy it to .env.
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Declarative routing file and optional per-role overrides.
CONTRACT_REVIEW_MODELS_FILE=contract_review_agent/app/model_routing.yaml
CONTRACT_REVIEW_TEXT_MODEL=
CONTRACT_REVIEW_VISION_MODEL=
CONTRACT_REVIEW_JUDGE_MODEL=

# deterministic requires no keys; live invokes provider APIs.
CONTRACT_REVIEW_MODE=deterministic
CONTRACT_REVIEW_MAX_RETRIES=2
CONTRACT_REVIEW_TIMEOUT_SECONDS=60

# Optional override; tests replace this with an isolated telemetry config.
CONTRACT_REVIEW_WITDEM_CONFIG=.witdem/witdem.yaml
